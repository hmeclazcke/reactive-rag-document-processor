scalar Long

type Query {
    topWords(datasetId: String!, limit: Int!): [WordCount!]!
    datasets: [Dataset!]!
}

type WordCount {
    word: String!
    count: Long!
}

type Dataset {
    datasetId: String!
    path: String!
    fileSizeBytes: Long!
    chunkSizeBytes: Long!
    chunkCount: Int!
}